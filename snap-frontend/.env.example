# URL del backend. Vite la incrusta en el bundle en BUILD-TIME, no se lee
# en runtime: cambiarla exige reconstruir/redesplegar.
#   local  -> http://localhost:3001
#   Vercel -> https://<servicio>.onrender.com (definirla en Project Settings
#             > Environment Variables antes del primer deploy)
VITE_API_URL=http://localhost:3001
