PORT=3001

# Secreto para firmar los JWT de sesion. Obligatorio: sin el, el login y todas
# las rutas de actas responden 503. Generar uno largo y aleatorio, distinto por
# entorno, con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Clave de OpenAI para el analisis de productos con vision.
# Nunca se expone al frontend; solo vive en el backend.
OPENAI_API_KEY=

# Modelo de vision a usar (por defecto gpt-4o-mini si se deja vacio).
OPENAI_VISION_MODEL=gpt-4o

# Proveedor de IA para el analisis de fotos: openai (por defecto) o deepseek.
# El proveedor deepseek existe en el codigo pero no esta validado en produccion
# (su modelo de vision es experimental) - ver src/services/vision/deepseekProvider.js.
VISION_PROVIDER=openai

# Solo si VISION_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MySQL. Local (docker compose) o gestionado en la nube (Aiven).
DB_HOST=localhost
DB_PORT=3306
DB_USER=acta_app
DB_PASSWORD=acta_app_pass
DB_NAME=acta_inteligente

# TLS para MySQL gestionado. En local con docker compose dejar en false.
# Con Aiven: DB_SSL=true y el ca.pem que se descarga del panel del servicio.
DB_SSL=false
# Desarrollo local: ruta al archivo (queda fuera del repo, ver .gitignore).
DB_SSL_CA_PATH=
# Render: el ca.pem en base64 y en una sola linea. Es la forma mas segura de
# pegarlo en un panel web, donde un bloque multilinea se puede truncar.
# Generarlo con:  base64 -w0 certs/aiven-ca.pem
DB_SSL_CA_B64=
# Alternativa: el contenido del ca.pem tal cual (si llega en una sola linea,
# el backend le reconstruye el formato).
DB_SSL_CA=

# Cloudinary: almacenamiento de fotos de items.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
